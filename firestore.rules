rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /Cuentas_Tutor/{tutorId} {
      allow read, write: if isOwner(tutorId);
      
      // Permitir la creación inicial del documento del tutor durante el registro
      // si el documento aún no existe.
      allow create: if isSignedIn() && request.auth.uid == tutorId && !exists(/databases/$(database)/documents/Cuentas_Tutor/$(tutorId));

      match /conversaciones/{convId} {
        allow read, write: if isOwner(tutorId);

        match /mensajes/{messageId} {
          allow read, write: if isOwner(tutorId);
        }
      }

      match /Integrantes/{integranteId} {
        allow read, write: if isOwner(tutorId);

        match /historial/{docId} {
          allow read, write: if isOwner(tutorId);
        }

        match /Documentos/{docId} {
          allow read, write: if isOwner(tutorId);
        }

        match /orientaciones/{sessionId} {
          allow read, write: if isOwner(tutorId);
        }

        match /orientaciones/{sessionId}/mensajes/{messageId} {
          allow read, write: if isOwner(tutorId);
        }

        match /episodes/{episodeId} {
          allow read, write: if isOwner(tutorId);
        }

        match /episodes/{episodeId}/events/{eventId} {
          allow read, write: if isOwner(tutorId);
        }

        match /episodes/{episodeId}/facts/{factId} {
          allow read, write: if isOwner(tutorId);
        }

        match /clinicalProfile/{profileId} {
          allow read, write: if isOwner(tutorId);
        }

        match /{path=**} {
          allow read, write: if isOwner(tutorId);
        }
      }

      match /limits/{limitId} {
        allow read, write: if isOwner(tutorId);
      }

      match /reports/{reportId} {
        allow read, write: if isOwner(tutorId);
      }

      match /documents/{docId} {
        allow read, write: if isOwner(tutorId);
      }

      // El saldo de tokens y el historial de transacciones solo los debe poder
      // escribir el backend (Admin SDK, vía Cloud Functions). Un usuario nunca
      // debe poder auto-otorgarse tokens o marcar un pago como exitoso desde el cliente.
      match /tokens/{tokenId} {
        allow read: if isOwner(tutorId);
        allow write: if false;
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(tutorId);
        allow write: if false;
      }

      match /{subcol}/{docId} {
        allow read, write: if isOwner(tutorId);
      }
    }

    match /users/{userId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /app_triage_sessions/{sessionId} {
      allow read, write, delete: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    match /triage_logs/{logId} {
      allow create: if isSignedIn();
      allow read, write, delete: if false;
    }

    match /alarms/{alarmId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
