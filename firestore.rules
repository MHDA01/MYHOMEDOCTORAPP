rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /Cuentas_Tutor/{tutorId} {
      allow read, write: if isOwner(tutorId);
      
      // Permitir la creación inicial del documento del tutor durante el registro
      // si el documento aún no existe.
      allow create: if isSignedIn() && request.auth.uid == tutorId && !exists(/databases/$(database)/documents/Cuentas_Tutor/$(tutorId));

      match /conversaciones/{convId} {
        allow read, write: if isOwner(tutorId);

        match /mensajes/{messageId} {
          allow read, write: if isOwner(tutorId);
        }

        // Resumen de la consulta para el médico y su revisión. Solo el servidor
        // (Admin SDK, tras verifyAdminAccess) lo escribe y lo lee: la dueña no
        // debe poder cambiar el nivel de atención ni borrar una señal de alarma
        // desde el navegador, y el resto del panel nunca llega hasta aquí.
        // Cuelga de la conversación para que se borre con la cuenta.
        match /resumen/{docId} {
          allow read, write: if false;
        }
      }

      match /Integrantes/{integranteId} {
        allow read, write: if isOwner(tutorId);

        match /historial/{docId} {
          allow read, write: if isOwner(tutorId);
        }

        match /Documentos/{docId} {
          allow read, write: if isOwner(tutorId);
        }

        match /orientaciones/{sessionId} {
          allow read, write: if isOwner(tutorId);
        }

        match /orientaciones/{sessionId}/mensajes/{messageId} {
          allow read, write: if isOwner(tutorId);
        }

        match /episodes/{episodeId} {
          allow read, write: if isOwner(tutorId);
        }

        match /episodes/{episodeId}/events/{eventId} {
          allow read, write: if isOwner(tutorId);
        }

        match /episodes/{episodeId}/facts/{factId} {
          allow read, write: if isOwner(tutorId);
        }

        match /clinicalProfile/{profileId} {
          allow read, write: if isOwner(tutorId);
        }

        match /{path=**} {
          allow read, write: if isOwner(tutorId);
        }
      }

      match /limits/{limitId} {
        allow read, write: if isOwner(tutorId);
      }

      match /reports/{reportId} {
        allow read, write: if isOwner(tutorId);
      }

      match /documents/{docId} {
        allow read, write: if isOwner(tutorId);
      }

      // El saldo de tokens y el historial de transacciones solo los debe poder
      // escribir el backend (Admin SDK, vía Cloud Functions). Un usuario nunca
      // debe poder auto-otorgarse tokens o marcar un pago como exitoso desde el cliente.
      match /tokens/{tokenId} {
        allow read: if isOwner(tutorId);
        allow write: if false;
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(tutorId);
        allow write: if false;
      }

      // Comodín para el resto de subcolecciones. `tokens` y `transactions`
      // quedan fuera a propósito: las reglas se SUMAN, así que sin esta
      // exclusión este comodín anularía el `allow write: if false` de arriba y
      // la dueña podría darse saldo o marcar un pago como exitoso desde el
      // navegador (hallazgo C1 de la auditoría). Leerlos sí se puede, por las
      // reglas explícitas de arriba.
      match /{subcol}/{docId} {
        allow read, write: if isOwner(tutorId) && !(subcol in ['tokens', 'transactions']);
      }
    }

    // Modalidad de acceso de cada cuenta (gratis de por vida o de pago). Vive
    // fuera de Cuentas_Tutor justamente porque ahí el dueño puede escribir
    // cualquier subcolección suya: aquí solo escribe el servidor.
    match /acceso_usuarios/{tutorId} {
      allow read, write: if false;
    }

    // Ficha clínica por integrante: antecedentes tipados, con su estado, su
    // fecha y la frase de la que salió cada uno. Vive aquí y no bajo
    // Cuentas_Tutor/Integrantes porque ahí hay un comodín RECURSIVO que le da
    // escritura al dueño, y en `{path=**}` no se puede excluir nada —como sí
    // se excluye `tokens` del comodín de un solo tramo—.
    //
    // Que el navegador no escriba es el punto: la ficha la arma el servidor a
    // partir del extractor, y cada hallazgo pasa por `registrar()`, que exige
    // la cita literal de lo que la persona dijo. Escribirla desde el cliente
    // sería saltarse esa validación entera.
    match /fichas_clinicas/{tutorId}/{resto=**} {
      allow read, write: if false;
    }

    // Quién abrió la consulta de qué paciente y cuándo. Solo escribe el
    // servidor y no lo lee nadie desde la app: un registro de accesos que el
    // propio panel pudiera editar no serviría de nada.
    match /auditoria_consultas/{registroId} {
      allow read, write: if false;
    }

    // La base de reglas del grafo, publicada. No es dato de ningún paciente:
    // es contenido clínico aprobado por el médico responsable, y es lo que
    // decide a quién se encamina a urgencias.
    //
    // Negado por los dos lados, y el de LECTURA importa tanto como el otro:
    // publicada en claro, cualquiera podría leerse los umbrales con los que la
    // app escala y, sabiéndolos, contestar para el otro lado. Quien la escribe
    // es el servidor con el Admin SDK, después de pasar el analizador de
    // `reglas-desde-firestore.ts` y `revisarBase()`.
    match /reglas_del_grafo/{docId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /app_triage_sessions/{sessionId} {
      allow read, write, delete: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    match /triage_logs/{logId} {
      allow create: if isSignedIn();
      allow read, write, delete: if false;
    }

    match /alarms/{alarmId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
